# Application
APP_NAME=DhioGame API
ENVIRONMENT=development
DEBUG=true

# Neon PostgreSQL connection string.
# Use the pooled connection string from the Neon dashboard.
# Both postgresql:// and postgresql+psycopg:// are accepted; the app normalizes them.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Room and upload limits
ROOM_TTL_HOURS=24
MAX_UPLOAD_SIZE_BYTES=5242880

# Local directory for temporary reference image uploads.
# Defaults to backend/uploads when omitted.
# UPLOAD_DIR=C:\absolute\path\to\uploads
